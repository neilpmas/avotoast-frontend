{
  "name": "avotoast-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "dev": "turbo dev"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@bufbuild/buf": true,
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  }
}
